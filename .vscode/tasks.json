{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Kariakoo Dev Server",
      "type": "shell",
      "command": "./node/node-v22.18.0-win-x64/npm.cmd",
      "args": ["run", "dev", "--", "--host", "0.0.0.0"],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
