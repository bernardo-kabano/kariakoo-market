{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Kariakoo PHP Server",
      "type": "shell",
      "command": ".\\php\\php.exe",
      "args": ["-S", "localhost:8000"],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
